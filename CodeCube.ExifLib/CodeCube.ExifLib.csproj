<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Rob Lohmann</Authors>
    <Copyright>Copyright Rob Lohmann 2019 - 2026</Copyright>
    <PackageProjectUrl>https://github.com/roblohmann/CodeCube.ExifLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/roblohmann/CodeCube.ExifLib</RepositoryUrl>
    <Description>Light-weight library to read exif information from images. This version is a port from the original ExifLib for .NET2.x</Description>
    <PackageTags>exif jpeg jpg gps</PackageTags>
    <PackageIcon>nuget-icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../nuget-icon.png" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>

</Project>