<Project>

  <!-- Centrale package-metadata voor alle projecten in deze repository. Een csproj kan deze waarden overschrijven. -->
  <PropertyGroup>
    <Authors>Rob Lohmann</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/roblohmann/CodeCube.ExifLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/roblohmann/CodeCube.ExifLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>1.1.4</VersionPrefix>
  </PropertyGroup>

</Project>
